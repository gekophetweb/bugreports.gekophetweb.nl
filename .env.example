APP_NAME="Bug Reports"
APP_ENV=production
# Generated on the first container start into storage/app/.env.local.
APP_KEY=
APP_DEBUG=false
APP_URL=https://bugreports.gekophetweb.nl
DISPLAY_TIMEZONE=Europe/Amsterdam
# Port on the Docker host (127.0.0.1 only). Change it when 8000 is already taken.
APP_PORT=8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bugreports
DB_USERNAME=bugreports
DB_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=720

# Must be the frontend subnet from docker-compose.yml (cloudflared), never *
TRUSTED_PROXIES=172.29.0.0/24

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
# The tunnel container only starts with the "tunnel" profile. Uncomment once the token is set, so every
# docker compose up (and ./docker/update.sh) starts it too.
#COMPOSE_PROFILES=tunnel

# Outgoing mail is configured by the superadmin in Admin → Mail. Until then mail goes to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=bugreports@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Issue syncing
# Optional NVD API key (https://nvd.nist.gov/developers/request-an-api-key): 50 instead of 5 requests per 30 s.
# Easier: save it in Admin → Setup, which wins over this value.
NVD_API_KEY=
# Optional GitHub token (no scopes needed) for php-src advisories: 5000 instead of 60 requests an hour.
GITHUB_TOKEN=
SYNC_BACKFILL_DAYS=90
SYNC_INCLUDE_MALWARE=false
SYNC_LOOKBACK_MINUTES=120
CRITICAL_UPDATE_WINDOW_DAYS=90
